<div class="variant variant-2">
  <div class="accent-line accent-1"></div>
  <div class="accent-line accent-2"></div>
  <div class="accent-line accent-3"></div>
  <div class="accent-line accent-4"></div>
  <div class="accent-line accent-5"></div>
  <div class="container">
    <h1>Tom Bonan</h1>
    <p class="tagline">トム・ボナン</p>
  </div>
</div>

<style>
  .variant-2 {
    background-color: #0a0a0a;
    min-height: 100vh;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: 'Gill Kayo', sans-serif;
    position: relative;
    overflow: hidden;
  }

  .accent-line {
    position: absolute;
    width: 120%;
    height: 6px;
    background: linear-gradient(90deg, transparent 0%, #c41e3a 20%, #c41e3a 80%, transparent 100%);
    left: -10%;
  }

  .accent-1 {
    top: 12%;
    transform: skewY(-4deg);
  }

  .accent-2 {
    top: 28%;
    transform: skewY(3deg);
    height: 4px;
    opacity: 0.7;
  }

  .accent-3 {
    top: 50%;
    transform: skewY(-2deg);
    height: 3px;
    opacity: 0.4;
  }

  .accent-4 {
    bottom: 28%;
    transform: skewY(-3deg);
    height: 4px;
    opacity: 0.7;
  }

  .accent-5 {
    bottom: 12%;
    transform: skewY(4deg);
  }

  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  h1 {
    color: #ffffff;
    font-weight: normal;
    margin: 0;
    padding: 0;
    font-size: 11rem;
    line-height: 0.85;
    letter-spacing: 0.05rem;
    text-transform: uppercase;
    text-shadow:
      5px 5px 0 #c41e3a,
      -1px -1px 0 #c41e3a,
      1px -1px 0 #c41e3a,
      -1px 1px 0 #c41e3a;
    transform: skewX(-8deg);
  }

  .tagline {
    color: #f5d742;
    font-size: 1.8rem;
    margin-top: 1.5rem;
    letter-spacing: 0.8rem;
    transform: skewX(-8deg);
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.5);
  }

  /* Mobile styles */
  @media (max-width: 480px) {
    .accent-line {
      height: 4px;
    }

    .accent-1 {
      top: 30%;
    }

    .accent-2 {
      top: 38%;
      height: 3px;
    }

    .accent-3 {
      top: 50%;
      height: 2px;
    }

    .accent-4 {
      bottom: 38%;
      height: 3px;
    }

    .accent-5 {
      bottom: 30%;
    }

    h1 {
      font-size: 4.5rem;
      letter-spacing: 0;
      text-shadow:
        3px 3px 0 #c41e3a,
        -1px -1px 0 #c41e3a,
        1px -1px 0 #c41e3a,
        -1px 1px 0 #c41e3a;
    }

    .tagline {
      font-size: 1.2rem;
      letter-spacing: 0.4rem;
    }
  }
</style>
