---

<div class="variant variant-1">
  <div class="container">
    <h1>Tom Bonan</h1>
    <div class="numbers">
      <div class="row">
        <span class="number white">Q</span>
        <span class="number">W</span>
        <span class="number">E</span>
        <span class="number">R</span>
        <span class="number">T</span>
        <span class="number">Y</span>
        <span class="number">U</span>
        <span class="number">I</span>
        <span class="number">P</span>
      </div>
      <div class="row staggered">
        <span class="number">A</span>
        <span class="number">S</span>
        <span class="number">D</span>
        <span class="number">F</span>
        <span class="number">G</span>
        <span class="number">H</span>
        <span class="number">J</span>
        <span class="number">K</span>
        <span class="number">L</span>
      </div>
      <div class="row">
        <span class="number">Z</span>
        <span class="number">X</span>
        <span class="number">C</span>
        <span class="number">V</span>
        <span class="number">B</span>
        <span class="number">N</span>
        <span class="number">M</span>
        <span class="number">,</span>
        <span class="number">.</span>
      </div>
    </div>
  </div>
</div>

<style>
  .variant-1 {
    background-color: #c9784a;
    min-height: 100vh;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: 'Gill Kayo', sans-serif;
  }

  .container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 2rem;
  }

  h1 {
    color: #363636;
    font-weight: normal;
    margin: 0;
    padding: 0;
    font-size: 9rem;
    line-height: 0.9;
    letter-spacing: 0.2rem;
  }

  .numbers {
    display: flex;
    flex-direction: column;
    align-self: center;
    gap: 0.4rem;
    margin-top: 3rem;
  }

  .row {
    display: flex;
    gap: 0.4rem;
  }

  .row.staggered {
    margin-left: 1.8rem;
  }

  .number {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background-color: #363636;
    color: #c9784a;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 1.4rem;
    transition: background-color 0.3s ease, color 0.3s ease;
    cursor: pointer;
  }

  .number:hover {
    background-color: #e8e8e8;
    color: #363636;
  }

  .number.white {
    background-color: #e8e8e8;
    color: #363636;
  }

  /* Mobile styles */
  @media (max-width: 480px) {
    .container {
      padding: 1.5rem;
      margin-top: -1rem;
    }

    h1 {
      font-size: 4rem;
      letter-spacing: 0.1rem;
    }

    .numbers {
      margin-top: 4rem;
      gap: 0.3rem;
    }

    .row {
      gap: 0.3rem;
    }

    .row.staggered {
      margin-left: 1.1rem;
    }

    .number {
      width: 1.8rem;
      height: 1.8rem;
      font-size: 1rem;
    }
  }
</style>
