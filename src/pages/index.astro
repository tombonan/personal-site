---
import Variant1 from '../components/variants/Variant1.astro';
import Variant2 from '../components/variants/Variant2.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Tom Bonan</title>
  </head>
  <body>
    <div class="variant-wrapper" data-variant="1">
      <Variant1 />
    </div>
    <div class="variant-wrapper" data-variant="2">
      <Variant2 />
    </div>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Gill Kayo';
    src: url('/fonts/Gill Kayo Condensed Regular.otf') format('opentype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    width: 100%;
  }

  body {
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  body.ready {
    opacity: 1;
  }

  .variant-wrapper {
    display: none;
  }

  .variant-wrapper.active {
    display: block;
  }
</style>

<script>
  const variants = document.querySelectorAll('.variant-wrapper');
  const params = new URLSearchParams(window.location.search);
  const variantParam = params.get('variant');

  let index;
  if (variantParam && parseInt(variantParam) >= 1 && parseInt(variantParam) <= variants.length) {
    index = parseInt(variantParam) - 1;
  } else {
    index = Math.floor(Math.random() * variants.length);
  }

  variants[index].classList.add('active');
  document.body.classList.add('ready');
</script>
